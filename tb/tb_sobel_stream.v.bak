`timescale 1ns/1ps
module tb_sobel_stream;
    parameter integer WIDTH = 16;
    parameter integer HEIGHT = 16;
    reg clk = 0;
    reg rst = 1;
    reg pixel_valid = 0;
    reg [7:0] pixel_in = 0;
    reg [15:0] threshold = 16'd180;
    wire edge_valid;
    wire [7:0] edge_out;
    wire [15:0] edge_score_out;
    wire [15:0] out_x, out_y;

    reg [7:0] image_mem [0:WIDTH*HEIGHT-1];
    integer infile, outfile;
    integer k;
    integer cycles;
    integer out_count;

    always #5 clk = ~clk;

    sobel_stream #(.WIDTH(WIDTH), .HEIGHT(HEIGHT)) dut (
        .clk(clk), .rst(rst), .pixel_valid(pixel_valid),
        .pixel_in(pixel_in), .threshold(threshold),
        .edge_valid(edge_valid), .edge_out(edge_out),
        .edge_score_out(edge_score_out), .out_x(out_x), .out_y(out_y)
    );

    initial begin
        $dumpfile("sobel_wave.vcd");
        $dumpvars(0, tb_sobel_stream);

        infile = $fopen("sample_data/input_pixels.hex", "r");
        if (infile == 0) begin
            $display("ERROR: cannot open sample_data/input_pixels.hex");
            $finish;
        end
        $fclose(infile);
        $readmemh("sample_data/input_pixels.hex", image_mem);

        outfile = $fopen("results/edge_pixels.hex", "w");
        if (outfile == 0) begin
            $display("ERROR: cannot create results/edge_pixels.hex");
            $finish;
        end

        repeat (3) @(posedge clk);
        rst <= 0;
        @(posedge clk);

        out_count = 0;
        cycles = 0;
        for (k = 0; k < WIDTH*HEIGHT; k = k + 1) begin
            // Drive away from the active edge so the DUT samples this pixel.
            @(negedge clk);
            pixel_valid = 1;
            pixel_in = image_mem[k];
            @(posedge clk);
            #1;
            cycles = cycles + 1;
            if (edge_valid) begin
                // Format: x y edge_byte edge_score (all hexadecimal).
                $fdisplay(outfile, "%04h %04h %02h %04h",
                          out_x, out_y, edge_out, edge_score_out);
                out_count = out_count + 1;
            end
        end

        @(negedge clk);
        pixel_valid = 0;
        pixel_in = 0;
        repeat (2) @(posedge clk);
        $fclose(outfile);
        $display("DONE: processed %0d input pixels in %0d pixel clocks.", WIDTH*HEIGHT, cycles);
        $display("Expected interior outputs: %0d; captured outputs: %0d",
                 (WIDTH-2)*(HEIGHT-2), out_count);
        $display("Threshold = %0d. Results: results/edge_pixels.hex", threshold);
        $finish;
    end
endmodule
